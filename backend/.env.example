# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (use your own PostgreSQL or Neon DB)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (use your own Redis or hosted service)
REDIS_URL=redis://localhost:6379/0

# ============================================
# FREE AI CONFIGURATION
# ============================================

# Groq API (FREE - get from https://console.groq.com/keys)
# Sign up for free, no credit card required
GROQ_API_KEY=gsk_YOUR_KEY_HERE
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# AI Providers - ALL FREE
STT_PROVIDER=groq
LLM_PROVIDER=groq
TTS_PROVIDER=edge

# Edge TTS Voice (optional - default: en-US-AriaNeural)
# List all voices: edge-tts --list-voices
EDGE_TTS_VOICE=en-US-AriaNeural

# ============================================
# OPTIONAL: Local Whisper (if STT_PROVIDER=local)
# ============================================
WHISPER_MODEL_SIZE=base

# ============================================
# OPTIONAL: Ollama (if LLM_PROVIDER=local)
# ============================================
LOCAL_LLM_BASE_URL=http://localhost:11434

# ============================================
# OPTIONAL: OpenAI (requires paid credits)
# ============================================
# Only needed if you want to use OpenAI instead of free alternatives
# OPENAI_API_KEY=sk-xxx
